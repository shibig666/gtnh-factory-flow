{
  "name": "gtnh-factory-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node tools/dev-local.mjs",
    "local-db": "tsx tools/local-db/serve.ts",
    "live": "tsx src/live/main.ts",
    "agent:relay": "tsx src/agent-relay/main.ts",
    "build:agent-relay": "esbuild src/agent-relay/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-agent-relay/main.mjs --log-level=warning",
    "build": "next build",
    "build:live": "esbuild src/live/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-live/live.mjs --log-level=warning",
    "build:mcp": "esbuild src/mcp/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-mcp/main.mjs --log-level=warning",
    "build:dsh": "node tools/dsh/build-plugin.mjs",
    "test:dsh": "node tools/dsh/test-plugin.mjs && node tools/dsh/test-settings.mjs",
    "test:dsh:install": "node tools/dsh/test-install.mjs",
    "test:dsh:client": "node tools/dsh/test-client.mjs",
    "test:dsh:app": "node tools/dsh/test-app.mjs",
    "test:dsh:browser": "node --import tsx tools/dsh/test-browser.mjs",
    "mcp": "tsx src/mcp/main.ts",
    "start": "next start",
    "serve": "node dist-server/server.mjs",
    "build:server": "esbuild tools/production/server.mjs --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.mjs --log-level=warning",
    "build:production": "npm run build && npm run build:server",
    "test:production:browser": "node --import tsx tools/production/test-browser.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:icons:browsers": "node tools/browser-tests/icon-sizing.mjs",
    "test:agent:browser": "node --import tsx tools/browser-tests/agent-flow.mjs",
    "test:agent:relay:browser": "node --import tsx tools/browser-tests/agent-relay.mjs",
    "test:dsh:relay:browser": "node --import tsx tools/dsh/test-relay-browser.mjs",
    "datasets:detect": "node tools/dataset-pipeline/scripts/detect-gtnh-versions.mjs",
    "datasets:manifest": "node tools/dataset-pipeline/scripts/rebuild-manifest.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "node tools/copy-highs-wasm.mjs",
    "prebuild": "node tools/copy-highs-wasm.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@next/env": "16.2.6",
    "@noble/hashes": "^2.4.0",
    "@supabase/supabase-js": "^2.110.8",
    "@xyflow/react": "^12.10.2",
    "gifenc": "^1.0.3",
    "highs": "^1.15.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pngjs": "^7.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "playwright-core": "1.63.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "8.0.13",
    "vitest": "^4.1.6"
  }
}
